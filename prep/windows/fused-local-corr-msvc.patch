+# Copyright (c) Meta Platforms, Inc. and affiliates.
+# All rights reserved.
+# This source code is licensed under the license found in the
+# LICENSE file in the root directory of this source tree.
+
+import os
+import shutil
+import glob
+
+from setuptools import find_packages, setup
+
+from torch.utils.cpp_extension import (
+    CppExtension,
+    CUDAExtension,
+    BuildExtension,
+    CUDA_HOME,
+)
+
+library_name = "local_corr"
+release_series = "0.3"
+
+
+def get_package_metadata():
+    torch_version = os.getenv("FUSED_LOCAL_CORR_TORCH_VERSION")
+    dependencies = ["torch", "numpy"]
+    version = f"{release_series}.0"
+
+    if torch_version:
+        release = torch_version.split("+", 1)[0]
+        major, minor, *_ = release.split(".")
+        version = f"{release_series}.{major}{minor}"
+        dependencies[0] = f"torch=={release}"
+
+    return version, dependencies
+
+
+def get_extensions():
+    debug_mode = os.getenv("DEBUG", "0") == "1"
+    if debug_mode:
+        print("Compiling in debug mode")
+
+    # Build CUDA if CUDA toolkit is present, even if no GPUs are visible
+    has_nvcc = shutil.which("nvcc") is not None
+    has_cuda_toolkit = (CUDA_HOME is not None) or has_nvcc
+    use_cuda = has_cuda_toolkit
+    extension = CUDAExtension if use_cuda else CppExtension
+
+    if os.name == "nt":  # MSVC (local Windows patch)
+        extra_link_args = []
+        cxx_args = ["/O2", "/openmp", "/std:c++17"]
+    else:
+        extra_link_args = ["-fopenmp"]
+        cxx_args = ["-O3" if not debug_mode else "-O0", "-fdiagnostics-color=always", "-fopenmp"]
+    extra_compile_args = {
+        "cxx": cxx_args,
+        "nvcc": [
+            "-O3" if not debug_mode else "-O0",
+        ],
+    }
+    if debug_mode:
+        extra_compile_args["cxx"].append("-g")
+
+        extra_compile_args["nvcc"].append("-g")
+        extra_link_args.extend(["-O0", "-g"])
+
+    this_dir = os.path.dirname(os.path.curdir)
+    extensions_dir = os.path.join(this_dir, library_name, "csrc")
+    sources = list(glob.glob(os.path.join(extensions_dir, "*.cpp")))
+
+    extensions_cuda_dir = os.path.join(extensions_dir, "cuda")
+    cuda_sources = list(glob.glob(os.path.join(extensions_cuda_dir, "*.cu")))
+
+    if use_cuda:
+        sources += cuda_sources
+
+    ext_modules = [
+        extension(
+            f"{library_name}._C",
+            sources,
+            extra_compile_args=extra_compile_args,
+            extra_link_args=extra_link_args,
+        )
+    ]
+
+    return ext_modules
+
+
+version, install_requires = get_package_metadata()
+
+
+setup(
+    version=version,
+    install_requires=install_requires,
+    packages=find_packages(),
+    ext_modules=get_extensions(),
+    cmdclass={"build_ext": BuildExtension},
+)
